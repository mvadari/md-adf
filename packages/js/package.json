{
  "name": "md-adf",
  "version": "0.1.2",
  "description": "Markdown-ADF converter for JavaScript and TypeScript.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "md-adf": "./dist/bin/mdAdf.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && mkdir -p dist/schemas && cp ../../schemas/adf-schema.json dist/schemas/adf-schema.json",
    "format": "prettier --check \"{bin,src,test}/**/*.{ts,mjs}\" package.json README.md tsconfig.json",
    "lint": "npm run lint:types && npm run lint:filenames && npm run lint:format",
    "lint:filenames": "node ../../tools/lint-ts-filenames.mjs bin src test",
    "lint:format": "prettier --check \"{bin,src,test}/**/*.{ts,mjs}\" package.json README.md tsconfig.json",
    "lint:types": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "npm run build && node test/conformance.test.mjs && node --test test/adf-validation.test.mjs test/options.test.mjs test/cli.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  }
}
