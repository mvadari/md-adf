{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-adf.dev/schema/manifest.schema.json",
  "title": "md-adf fixture manifest",
  "type": "object",
  "required": ["version", "generatedAt", "cases"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "direction", "features"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "direction": {
            "enum": ["adf-to-md", "md-to-adf", "roundtrip"]
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
